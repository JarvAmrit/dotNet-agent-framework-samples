{
  "_description": "POST /api/agents/hosted — Creates a new hosted (containerized) agent version in Azure AI Foundry.",
  "_curl": "curl -X POST 'https://localhost:5001/api/agents/hosted?projectEndpoint=https://your-project.services.ai.azure.com' -H 'Content-Type: application/json' -d @POST_hosted.json",

  "agentName": "data-processing-agent",
  "image": "myregistry.azurecr.io/data-processor:2.1.0",
  "cpu": "2",
  "memory": "4Gi",
  "protocolVersions": [
    { "protocol": "A2A", "version": "0.2.1" }
  ],
  "environmentVariables": {
    "APP_ENV": "production",
    "LOG_LEVEL": "info",
    "MAX_BATCH_SIZE": "100"
  },
  "description": "Containerized data-processing agent that speaks the A2A protocol."
}
